{
  "manifest_version": 3,
  "name": "GyoMail",
  "version": "0.1.0",
  "description": "AI-powered email classification for Gmail.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}